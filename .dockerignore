# Keep the build context small and free of secrets / local state.
.git
.github
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Local runtime & secrets — never bake into the image
.env
.env.*
!.env.example
data/
logs/
*.db
*.db-wal
*.db-shm

# Dashboard frontend (separate image) and docs/tests not needed at runtime
dashboard/frontend
tests
docs
personal_space
.omc
.omx
*.md
!README.md
