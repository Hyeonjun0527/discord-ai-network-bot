# Discord Developer Portal에서 발급한 봇 토큰입니다. 실제 값은 .env에만 넣으세요.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token

# Ollama 서비스 주소. 로컬 실행: http://localhost:11434 / Docker: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# 서버별 설정이 없을 때 사용할 기본 모델입니다.
OLLAMA_MODEL=llama3.1:8b

# SQLite 경로입니다. 디렉터리는 앱 시작 시 자동 생성됩니다.
DATABASE_URL=sqlite:///./data/discord_assistant.db

# 기본 요약 메시지 수와 최대 프롬프트 본문 길이입니다.
DEFAULT_SUMMARY_LIMIT=50
MAX_CONTEXT_CHARS=12000
DEFAULT_LANGUAGE=ko
OLLAMA_TIMEOUT_SECONDS=60
# Ollama 샘플링 파라미터 (선택). 응답 다양성과 컨텍스트 길이를 조정합니다.
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
AUTO_SYNC_COMMANDS=true

# API 키 암호화에 사용됩니다. 실제 운영 시 반드시 변경하세요.
SECRET_KEY=change-me-in-production

# 봇 다운/오류 발생 시 알림을 받을 Discord 사용자 ID (숫자).
# Discord → 개발자 모드 → 사용자 우클릭 → 'ID 복사'로 얻을 수 있습니다.
# 설정하지 않으면 알림이 전송되지 않습니다.
DEVELOPER_USER_ID=

# ── 원격 에이전트(BYO-LLM) 릴레이 (선택, ADR 0002/0003) ───────────────────
# 유저/방장/커뮤니티 프로바이더 PC 의 로컬 LLM 을 중앙 봇으로 사용하는 기능.
# 모두 코드 기본값이 있어 생략 가능하며, 아래 주석을 해제해 조정할 수 있습니다.
# RELAY_ENABLED=false                  # 릴레이 WebSocket 서버 활성화(기본 비활성)
# RELAY_HOST=0.0.0.0                   # 바인드 호스트
# RELAY_PORT=8765                      # 릴레이 포트
# RELAY_PATH=/agent                    # 에이전트 접속 경로
# RELAY_REQUEST_TIMEOUT_SECONDS=120    # 추론 요청 타임아웃(초)
# RELAY_MAX_CONCURRENCY_PER_HOST=1     # 호스트당 동시 처리 요청 수(과부하 보호)
# RELAY_HEARTBEAT_SECONDS=30           # 연결 heartbeat 주기(초)
# AGENT_TOKEN_TTL_SECONDS=600          # 페어링/호스트 토큰 수명(초)
