# Discord Developer Portal에서 발급한 봇 토큰입니다. 실제 값은 .env에만 넣으세요.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token

# Ollama 기본 주소입니다. 로컬 실행이면 보통 이 값을 그대로 씁니다.
OLLAMA_BASE_URL=http://localhost:11434

# 서버별 설정이 없을 때 사용할 기본 모델입니다.
OLLAMA_MODEL=llama3.1:8b

# SQLite 경로입니다. 디렉터리는 앱 시작 시 자동 생성됩니다.
DATABASE_URL=sqlite:///./data/discord_assistant.db

# 기본 요약 메시지 수와 최대 프롬프트 본문 길이입니다.
DEFAULT_SUMMARY_LIMIT=50
MAX_CONTEXT_CHARS=12000
DEFAULT_LANGUAGE=ko
OLLAMA_TIMEOUT_SECONDS=60
AUTO_SYNC_COMMANDS=true

# API 키 암호화에 사용됩니다. 실제 운영 시 반드시 변경하세요.
SECRET_KEY=change-me-in-production

# Docker 환경에서 Ollama 서비스 주소 (docker-compose 사용 시 자동 설정됨).
# 로컬 실행 시 http://localhost:11434 그대로 두세요.
OLLAMA_BASE_URL=http://localhost:11434

# 봇 다운/오류 발생 시 알림을 받을 Discord 사용자 ID (숫자).
# Discord → 개발자 모드 → 사용자 우클릭 → 'ID 복사'로 얻을 수 있습니다.
# 설정하지 않으면 알림이 전송되지 않습니다.
DEVELOPER_USER_ID=
