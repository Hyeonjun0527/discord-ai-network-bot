# central-server 환경변수 (docker-compose / 실행 시 주입). 실제 값은 .env 에만, 커밋 금지.

# Discord 봇 토큰(JDA). DISCORD_ENABLED=true 일 때 필요.
DISCORD_BOT_TOKEN=
DISCORD_ENABLED=false
# @니아 질문을 쓸 때 true. Developer Portal Bot 설정의 Message Content Intent 와 일치해야 함.
DISCORD_MESSAGE_CONTENT_INTENT_ENABLED=true
# Message Content Intent 가 거부되면 @멘션 질문을 끄고 슬래시 명령만 자동 재기동.
DISCORD_FALLBACK_WITHOUT_MESSAGE_CONTENT_ON_4014=true

# Postgres 비밀번호(compose db 서비스와 공유).
DB_PASSWORD=changeme

# DB 연결(compose 가 아닌 외부 Postgres 사용 시).
# DB_URL=jdbc:postgresql://localhost:5432/central
# DB_USER=central

# 개발/E2E 전용 엔드포인트(/dev/*). 운영에서는 절대 true 금지.
CENTRAL_DEV_ENABLED=false

# 대시보드 관리자 인증(Discord OAuth2, #196/197). 기본 false(오픈 읽기전용).
# true 로 켜면 대시보드 데이터·쓰기 API 에 OAuth2 로그인 필요. 설정은 OPERATIONS.md 참고.
CENTRAL_OAUTH_ENABLED=false
# OAuth 를 켜기 전 운영 관리자 API 보호용 임시 토큰. 실제 값은 ENV_FILE/.env 에만 보관.
# CENTRAL_DASHBOARD_ADMIN_TOKEN=change-me-long-random
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_DISCORD_CLIENT_ID=...   # 시크릿, 커밋 금지
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_DISCORD_CLIENT_SECRET=...

# 릴레이/토큰 튜닝(선택, 코드 기본값 있음).
# RELAY_PATH=/agent
# RELAY_MAX_CONCURRENCY=1
# RELAY_HEARTBEAT_SECONDS=30
# RELAY_REQUEST_TIMEOUT_SECONDS=120
# AGENT_TOKEN_TTL_SECONDS=600

# AI Network 기능 플래그/긴급 차단.
# 운영 장애·과부하 시 ENV_FILE 에서 개별 기능을 즉시 줄이거나 끌 수 있다.
# AI_NETWORK_ENABLED=true
# AI_NETWORK_DASHBOARD_ENABLED=true
# AI_NETWORK_PRESETS_ENABLED=true
# AI_NETWORK_RAG_ENABLED=true
# AI_NETWORK_MULTI_RESPONSE_ENABLED=true
# AI_NETWORK_MULTI_RESPONSE_SYNTHESIS_ENABLED=true
# AI_NETWORK_MULTI_RESPONSE_RAG_ENABLED=true
# AI_NETWORK_MULTI_RESPONSE_MAX_FANOUT=2
# AI_NETWORK_CHANNEL_AI_ENABLED=true
# AI_NETWORK_KILL_SWITCH=false
