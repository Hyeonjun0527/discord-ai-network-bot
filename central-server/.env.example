# central-server 환경변수 (docker-compose / 실행 시 주입). 실제 값은 .env 에만, 커밋 금지.

# Discord 봇 토큰(JDA). DISCORD_ENABLED=true 일 때 필요.
DISCORD_BOT_TOKEN=
DISCORD_ENABLED=false

# Postgres 비밀번호(compose db 서비스와 공유).
DB_PASSWORD=changeme

# DB 연결(compose 가 아닌 외부 Postgres 사용 시).
# DB_URL=jdbc:postgresql://localhost:5432/central
# DB_USER=central

# 개발/E2E 전용 엔드포인트(/dev/*). 운영에서는 절대 true 금지.
CENTRAL_DEV_ENABLED=false

# 대시보드 관리자 인증(Discord OAuth2, #196/197). 기본 false(오픈 읽기전용).
# true 로 켜면 대시보드 데이터·쓰기 API 에 OAuth2 로그인 필요. 설정은 OPERATIONS.md 참고.
CENTRAL_OAUTH_ENABLED=false
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_DISCORD_CLIENT_ID=...   # 시크릿, 커밋 금지
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_DISCORD_CLIENT_SECRET=...

# 릴레이/토큰 튜닝(선택, 코드 기본값 있음).
# RELAY_PATH=/agent
# RELAY_MAX_CONCURRENCY=1
# RELAY_HEARTBEAT_SECONDS=30
# RELAY_REQUEST_TIMEOUT_SECONDS=120
# AGENT_TOKEN_TTL_SECONDS=600
