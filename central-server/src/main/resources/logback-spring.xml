<?xml version="1.0" encoding="UTF-8"?>
<!--
  구조적 로깅 + 로그 회전 (차수 15 #218/#222).
  - 콘솔: requestId(MDC) 포함 패턴.
  - 파일(prod 프로파일): 일자별 회전 + 크기 상한 + 보존 기간.
  로그 디렉터리는 LOG_DIR(기본 ./logs) 환경변수로 조정.
-->
<configuration>
    <!--
      NEXA-P17-T013: 로그 메시지 redaction 바인딩.
      %redactedMsg 는 RedactingMessageConverter 로 매핑돼 snowflake/API key/Bearer 토큰을 마스킹한다
      (SensitiveLogRedactor 와 동일 패턴 — scan-sensitive-logs.py 스캐너의 SSOT). 모든 appender 패턴이
      %msg 대신 %redactedMsg 를 써서 PII·비밀이 콘솔/파일 어느 쪽에도 남지 않는다.
    -->
    <conversionRule conversionWord="redactedMsg"
                    converterClass="com.discordassistant.central.global.observability.RedactingMessageConverter"/>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{36} - %redactedMsg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 운영(prod) 에서만 파일 회전 appender 사용 -->
    <springProfile name="prod">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/central-server.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/central-server.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${PATTERN}</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
