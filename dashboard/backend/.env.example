# Discord OAuth2 credentials
# Create an application at https://discord.com/developers/applications
# Under OAuth2 → General, add a Redirect URI matching DISCORD_REDIRECT_URI
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# JWT signing secret — generate a random 32-byte hex string:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-in-production

# Path to the SQLite DB used by the Discord bot
# Must match DATABASE_URL in the bot's .env
DATABASE_URL=sqlite:///../../data/discord_assistant.db

# Ollama base URL (used by the models endpoint)
OLLAMA_BASE_URL=http://localhost:11434

# Frontend origin for CORS (adjust for production)
CORS_ORIGIN=http://localhost:3000

# Dashboard public URL — surfaced in the Discord /help command
DASHBOARD_URL=http://localhost:3000
