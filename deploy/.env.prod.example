# Production env template for the Docker Compose deploy.
#
# Fill this in and store the WHOLE thing as a single GitHub Actions secret named
# ENV_FILE. The deploy workflow renders it to DEPLOY_DIR/.env (chmod 600) on every
# deploy; compose.prod.yml reads it via env_file. NEVER commit real values or bake
# them into the image.
#
#   cp deploy/.env.prod.example /tmp/bot.env && $EDITOR /tmp/bot.env
#   gh secret set ENV_FILE --repo Hyeonjun0527/discord-assistant < /tmp/bot.env && rm -f /tmp/bot.env
#
#   DEPLOY_DIR default: $HOME/discord-assistant  (override via repo variable DEPLOY_DIR)
#   멀티 호스트 배포(#73): repo variable DEPLOY_TARGETS(JSON 배열)로 호스트별 러너 라벨/배포
#   디렉터리를 지정해 병렬 배포. 미설정 시 단일 호스트(기존 동작). 자세한 내용은
#   deploy/SELF_HOSTED_RUNNER.md "6. 멀티 호스트 배포" 참고.

# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=replace-with-your-bot-token
# API 키 암호화용. 운영에서는 반드시 강한 랜덤 값으로 변경.
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-strong-random-secret

# ── Storage (bind-mounted to ./data in compose.prod.yml) ─────────────────────
DATABASE_URL=sqlite:///./data/discord_assistant.db

# ── Cloud-API runtime: Ollama 헬스체크 비활성 ────────────────────────────────
HEALTHCHECK_REQUIRE_OLLAMA=false

# ── Optional ──────────────────────────────────────────────────────────────────
# 봇 다운/오류 알림을 받을 Discord 사용자 ID (숫자). 비우면 알림 OFF.
# DEVELOPER_USER_ID=
# 슬래시 명령 자동 동기화 (기본 true)
# AUTO_SYNC_COMMANDS=true

# 참고: OpenAI/Anthropic API 키는 봇의 `/settings` 패널에서 입력하면
# Fernet으로 암호화되어 DB에 저장됩니다(여기 env에 둘 필요 없음).
# Ollama를 쓰려면 OLLAMA_BASE_URL 을 지정하고 HEALTHCHECK_REQUIRE_OLLAMA=true 로.
