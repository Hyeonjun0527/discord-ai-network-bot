[Unit]
Description=Discord AI Assistant Bot
Documentation=https://github.com/your-org/discord-assistant
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=discord-bot
Group=discord-bot

WorkingDirectory=/opt/discord-assistant
EnvironmentFile=/opt/discord-assistant/.env

ExecStart=/opt/discord-assistant/.venv/bin/python -m discord_assistant

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=120
StartLimitBurst=5

# Logging (journald captures stdout/stderr automatically)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discord-assistant

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/discord-assistant/data /opt/discord-assistant/logs

[Install]
WantedBy=multi-user.target
