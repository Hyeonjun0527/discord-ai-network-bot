{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discord-assistant.local/nexa/task-schema.json",
  "title": "NEXA 500 task graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "generated_from",
    "execution_policy",
    "recommended_new_contexts",
    "programs",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "generated_from": {
      "type": "string",
      "minLength": 1
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "unit_of_work",
        "gate_rule",
        "later_tasks",
        "production_rule"
      ],
      "properties": {
        "unit_of_work": {
          "type": "string",
          "minLength": 1
        },
        "gate_rule": {
          "type": "string",
          "minLength": 1
        },
        "later_tasks": {
          "type": "string",
          "minLength": 1
        },
        "production_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recommended_new_contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "programs": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 500,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "responsibility"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "goal",
        "roots",
        "exit_gate",
        "task_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_gate": {
          "type": "string",
          "minLength": 1
        },
        "task_count": {
          "type": "integer",
          "const": 25
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "program",
        "sequence",
        "title",
        "status",
        "kind",
        "risk",
        "depends_on",
        "recommended_paths",
        "deliverable",
        "acceptance",
        "verification",
        "human_gate",
        "execution_rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^NEXA-P[0-9]{2}-T[0-9]{3}$"
        },
        "program": {
          "type": "string",
          "pattern": "^P[0-9]{2}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "READY",
            "IN_PROGRESS",
            "REVIEW",
            "VERIFIED",
            "BLOCKED",
            "ABANDONED"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "audit",
            "decision",
            "documentation",
            "experiment",
            "implementation",
            "review",
            "security"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^NEXA-P[0-9]{2}-T[0-9]{3}$"
          }
        },
        "recommended_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_gate": {
          "type": "boolean"
        },
        "execution_rule": {
          "type": "string",
          "minLength": 1
        },
        "verification_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "verification_evidence"
            ]
          }
        }
      ]
    }
  }
}
