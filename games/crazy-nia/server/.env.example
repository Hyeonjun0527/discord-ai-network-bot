# Crazy Nia game server — environment (copy to .env, fill in, DO NOT commit .env).
#
# Discord Activity OAuth token exchange. Required ONLY when running as a Discord
# Activity; the plain local/web multiplayer server works without these.
#   - Get both from the Discord Developer Portal -> your app -> OAuth2.
#   - DISCORD_CLIENT_SECRET is a SECRET: server-only, never expose to the client or
#     commit it. The browser never sees it (the /api/token route uses it server-side).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: port the Colyseus server + token route listen on (default 2567).
# PORT=2567
