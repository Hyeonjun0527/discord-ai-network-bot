# systemd 유닛 — Linux 에서 Provider Agent 를 **사용자 단위** 백그라운드 서비스로 실행.
# 관리자 권한 불필요: 시스템(/etc/systemd/system)이 아니라 --user 로 설치한다.
# 설치:
#   cp nexa.service ~/.config/systemd/user/
#   systemctl --user edit nexa  # 환경변수 설정
#   systemctl --user enable --now nexa
[Unit]
Description=Nexa Provider Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 토큰/주소는 EnvironmentFile 또는 systemctl edit 로 주입(여기에 평문 금지)
Environment=RELAY_URL=ws://CHANGE-ME:8080/agent
Environment=OLLAMA_BASE_URL=http://localhost:11434
# 비대화형 서비스는 첫 실행 동의 화면을 띄울 수 없으므로 사전 동의가 필요하다.
# 아래 안내(사용량 제한·서버/Ollama 주소·개인정보)를 확인했다면 주석을 해제한다.
# Environment=AGENT_ACCEPT_TERMS=1
# Environment=AGENT_TOKEN=...   ← systemctl --user edit 로 별도 설정 권장
ExecStart=%h/.local/bin/nexa
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
