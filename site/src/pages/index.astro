---
import installAssets from "../../../packaging/assets.json";
import SiteLayout from "../layouts/SiteLayout.astro";

const assets = installAssets as {
  brandName: string;
  brandTagline: string;
  defaultTextModel: string;
  installCommands: { mac: string; win: string };
  assets: { guiMacDmg: string; guiWin: string };
};

const installCards = [
  {
    os: "macOS",
    command: assets.installCommands.mac,
    note: "Homebrew가 다운로드 해시를 검증합니다.",
  },
  {
    os: "Windows",
    command: assets.installCommands.win,
    note: "winget이 설치 파일 무결성을 확인합니다.",
  },
];
---

<SiteLayout
  title={`${assets.brandName} - Discord AI assistant`}
  description="Nexa는 Discord 서버에 로컬 AI와 무료 클라우드 AI를 연결하는 운영형 AI assistant입니다."
>
  <header class="topbar">
    <a class="brand" href="/">
      <img src="/img/nexa-logo.png" alt="" />
      <span>
        <strong>{assets.brandName}</strong>
        <small>{assets.brandTagline}</small>
      </span>
    </a>
    <nav aria-label="주요 링크">
      <a href="#install">설치</a>
      <a href="#ops">운영</a>
      <a href="/privacy">개인정보</a>
      <a href="/terms">약관</a>
    </nav>
    <a class="nav-cta" href="/install">시작</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Discord AI operations</p>
        <h1>{assets.brandName}</h1>
        <p class="lede">
          서버 멤버의 로컬 AI와 중앙 클라우드 폴백을 하나의 Discord AI 멤버처럼 운영합니다.
          관리자에게는 라우팅, 안전 정책, 프리셋, 지식 관리 흐름을 제공합니다.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/install">설치하기</a>
          <a class="button secondary" href="#ops">운영 흐름 보기</a>
        </div>
      </div>
      <figure class="hero-visual">
        <img src="/img/install-panel.webp" alt="Nexa 설치 화면 미리보기" />
        <figcaption>
          <strong>{assets.defaultTextModel}</strong>
          <span>기본 로컬 텍스트 모델</span>
        </figcaption>
      </figure>
    </section>

    <section id="ops" class="band">
      <div class="section-head">
        <p>운영 구조</p>
        <h2>Kotlin API와 정적 프론트가 분리됩니다.</h2>
      </div>
      <div class="flow-grid">
        <article>
          <span>01</span>
          <h3>Astro 공개 사이트</h3>
          <p>설치, SEO, GEO, 법적 고지, 릴리즈 안내를 빠른 정적 페이지로 배포합니다.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Vite React 콘솔</h3>
          <p>서버 설정, 채널 정책, 프리셋, 지식 상태처럼 상태가 많은 관리자 화면을 담당합니다.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Kotlin central-server</h3>
          <p>Discord 봇, Provider relay, 라이선스, 정책 API, 데이터 저장소를 계속 소유합니다.</p>
        </article>
      </div>
    </section>

    <section id="install" class="install-section">
      <div class="section-head">
        <p>안전한 설치</p>
        <h2>brew와 winget 릴리즈 흐름은 그대로 유지합니다.</h2>
      </div>
      <div class="install-grid">
        {installCards.map((card) => (
          <article>
            <div>
              <span>{card.os}</span>
              <strong>{card.note}</strong>
            </div>
            <code>{card.command}</code>
          </article>
        ))}
      </div>
      <p class="release-note">
        직접 다운로드 자산은 기존 이름을 유지합니다:
        <code>{assets.assets.guiMacDmg}</code>, <code>{assets.assets.guiWin}</code>.
      </p>
    </section>
  </main>
</SiteLayout>
