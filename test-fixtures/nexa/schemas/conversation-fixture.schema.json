{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discord-assistant.local/nexa/conversation-fixture.schema.json",
  "title": "NEXA conversation replay fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "title",
    "time",
    "guild",
    "actors",
    "events"
  ],
  "properties": {
    "schemaVersion": { "const": "nexa.conversation-fixture.v1" },
    "fixtureId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "time": { "$ref": "#/$defs/time" },
    "guild": { "$ref": "#/$defs/guild" },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "lineRange", "originalTimeKnown"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "lineRange": { "type": "string", "pattern": "^[0-9]+-[0-9]+$" },
        "originalTimeKnown": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseInstant", "zone", "resolutionMs"],
      "properties": {
        "baseInstant": { "type": "string", "format": "date-time" },
        "zone": { "type": "string", "minLength": 1 },
        "resolutionMs": { "type": "integer", "minimum": 1 }
      }
    },
    "guild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guildId", "channelId"],
      "properties": {
        "guildId": { "type": "string", "minLength": 1 },
        "channelId": { "type": "string", "minLength": 1 },
        "threadId": { "type": "string", "minLength": 1 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "label", "displayName", "kind"],
      "properties": {
        "actorId": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
        "label": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "nexa", "bot", "system"] }
      }
    },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/messageCreate" },
        { "$ref": "#/$defs/messageUpdate" },
        { "$ref": "#/$defs/messageDelete" },
        { "$ref": "#/$defs/typingStart" },
        { "$ref": "#/$defs/reactionAdd" },
        { "$ref": "#/$defs/reactionRemove" }
      ]
    },
    "messageCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "eventId", "type", "atOffsetMs", "messageId", "authorId", "content"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "const": "message_create" },
        "atOffsetMs": { "type": "integer", "minimum": 0 },
        "messageId": { "type": "string", "minLength": 1 },
        "authorId": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
        "content": { "type": "string" },
        "replyToMessageId": { "type": "string", "minLength": 1 },
        "mentions": { "type": "array", "items": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" } },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } }
      }
    },
    "messageUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "eventId", "type", "atOffsetMs", "messageId", "editorId", "content"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "const": "message_update" },
        "atOffsetMs": { "type": "integer", "minimum": 0 },
        "messageId": { "type": "string", "minLength": 1 },
        "editorId": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
        "previousContent": { "type": "string" },
        "content": { "type": "string" }
      }
    },
    "messageDelete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "eventId", "type", "atOffsetMs", "messageId"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "const": "message_delete" },
        "atOffsetMs": { "type": "integer", "minimum": 0 },
        "messageId": { "type": "string", "minLength": 1 },
        "deletedByActorId": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
        "contentAvailable": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "typingStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "eventId", "type", "atOffsetMs", "actorId"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "const": "typing_start" },
        "atOffsetMs": { "type": "integer", "minimum": 0 },
        "actorId": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
        "durationMs": { "type": "integer", "minimum": 1 }
      }
    },
    "reactionAdd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "eventId", "type", "atOffsetMs", "messageId", "actorId", "emoji"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "const": "reaction_add" },
        "atOffsetMs": { "type": "integer", "minimum": 0 },
        "messageId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
        "emoji": { "$ref": "#/$defs/emoji" },
        "reactionClass": { "type": "string", "minLength": 1 }
      }
    },
    "reactionRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "eventId", "type", "atOffsetMs", "messageId", "actorId", "emoji"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "const": "reaction_remove" },
        "atOffsetMs": { "type": "integer", "minimum": 0 },
        "messageId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
        "emoji": { "$ref": "#/$defs/emoji" },
        "reactionClass": { "type": "string", "minLength": 1 }
      }
    },
    "emoji": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["unicode", "custom"] },
        "value": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachmentId", "mediaType"],
      "properties": {
        "attachmentId": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "redacted": { "type": "boolean" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceTranscript": { "type": "array", "items": { "$ref": "#/$defs/transcriptLine" } },
        "bursts": { "type": "array", "items": { "$ref": "#/$defs/expectedBurst" } }
      }
    },
    "transcriptLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speakerLabel", "text"],
      "properties": {
        "speakerLabel": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" },
        "text": { "type": "string" }
      }
    },
    "expectedBurst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["burstId", "actorId", "messageIds"],
      "properties": {
        "burstId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
        "messageIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string" }
      }
    }
  }
}
